{
  "name": "web-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@date-io/date-fns": "^1.1.0",
    "@material-ui/core": "^3.7.1",
    "@material-ui/icons": "^3.0.1",
    "@material-ui/lab": "^3.0.0-alpha.24",
    "@types/file-saver": "^1.3.0",
    "@types/jest": "24.0.13",
    "@types/memoize-one": "^4.1.0",
    "@types/react-custom-scrollbars": "^4.0.3",
    "@types/react-dnd": "^2.0.36",
    "@types/react-dnd-html5-backend": "^2.1.9",
    "@types/react-dom": "^16.0.9",
    "@types/react-loadable": "^5.4.1",
    "@types/react-redux": "^6.0.9",
    "@types/react-router": "^4.0.23",
    "@types/react-router-dom": "^4.2.6",
    "@types/react-swipeable-views": "^0.12.2",
    "@types/url-search-params": "^0.10.1",
    "@types/uuid": "^3.4.3",
    "@ungap/url-search-params": "^0.1.2",
    "csv-parse": "^2.2.0",
    "csv-stringify": "^3.0.0",
    "date-fns": "2.0.0-alpha.27",
    "file-saver": "^1.3.8",
    "fuzzy-match-utils": "^1.3.0",
    "material-ui-pickers": "^2.1.2",
    "memoize-one": "^5.0.0",
    "moment": "^2.22.1",
    "react": "^16.6.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dnd": "^2.6.0",
    "react-dnd-html5-backend": "^2.6.0",
    "react-dom": "^16.6.0",
    "react-loadable": "^5.5.0",
    "react-redux": "^5.1.0",
    "react-router": "^4.2.0",
    "react-router-dom": "^4.2.2",
    "react-swipeable-views": "^0.13.0",
    "react-vis": "^1.11.5",
    "redux": "^4.0.1",
    "redux-localstorage": "^0.4.1",
    "redux-observable": "^1.0.0",
    "rxjs": "^6.3.3",
    "uuid": "^3.2.1"
  },
  "scripts": {
    "start": "npm run copy-cert && env-cmd ver,dev,local react-scripts start",
    "start-uat-build": "npm run build-uat && http-server ./build -p 443 --ssl --key ./cert/server.pem --cert ./cert/server.pem",
    "start-remote": "npm run copy-cert && env-cmd ver,dev,uat-dev react-scripts start",
    "build-uat": "env-cmd ver,uat,no-map react-scripts build",
    "build-rc": "env-cmd ver,rc,no-map react-scripts build",
    "build-prod": "env-cmd ver,prod,no-map react-scripts build",
    "build-with-map": "env-cmd ver,uat react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "test-coverage": "react-scripts test --env=jsdom --coverage",
    "eject": "react-scripts eject",
    "a": "node code_templates/create-action/create-action.js",
    "c": "node code_templates/create-component/create-component.js",
    "lint": "tslint --project tsconfig.json -c ../shared/tslint.json src/**/*.ts{,x}",
    "lint-fix": "tslint --project tsconfig.json -c ../shared/tslint.json src/**/*.ts{,x} --fix",
    "copy-cert": "node cert/copy.js"
  },
  "devDependencies": {
    "@types/facebook-js-sdk": "^2.8.6",
    "acorn-dynamic-import": "^3.0.0",
    "env-cmd": "^8.0.2",
    "http-server": "^0.11.1",
    "react-scripts": "^3.0.1",
    "rxjs-tslint": "^0.1.5",
    "ts-jest": "^24.0.2",
    "tslint": "^5.11.0",
    "tslint-react": "^3.6.0",
    "typescript": "^3.4.5"
  },
  "eslintConfig": {
    "extends": "react-app",
    "rules": {
      "no-useless-computed-key": "off"
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
